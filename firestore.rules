rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function initialUserDocument() {
      return request.resource.data.get('honorPoints', 0) == 0
        && request.resource.data.get('achievementPoints', 0) == 0
        && request.resource.data.get('gameState', {}).get('honorPoints', 0) == 0
        && request.resource.data.get('gameState', {}).get('achievementPoints', 0) == 0;
    }

    function protectedUserFieldsUnchanged() {
      return request.resource.data.get('honorPoints', null) == resource.data.get('honorPoints', null)
        && request.resource.data.get('achievementPoints', null) == resource.data.get('achievementPoints', null)
        && request.resource.data.get('gameState', {}).get('honorPoints', null)
          == resource.data.get('gameState', {}).get('honorPoints', null)
        && request.resource.data.get('gameState', {}).get('achievementPoints', null)
          == resource.data.get('gameState', {}).get('achievementPoints', null)
        && request.resource.data.get('gameState', {}).get('achievements', {}).get('claimedIds', null)
          == resource.data.get('gameState', {}).get('achievements', {}).get('claimedIds', null);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && initialUserDocument();
      allow update: if isOwner(userId) && protectedUserFieldsUnchanged();
      // Account deletion is performed by the Admin SDK callable so the
      // server-owned ranking documents are deleted atomically with the user.
      allow delete: if false;
    }

    match /rankings/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /rankingState/{userId} {
      allow read, write: if false;
    }

    match /rankingEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
