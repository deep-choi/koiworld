rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function initialUserDocument() {
      return request.resource.data.get('honorPoints', 0) == 0
        && request.resource.data.get('achievementPoints', 0) == 0
        && request.resource.data.get('gameState', {}).get('honorPoints', 0) == 0
        && request.resource.data.get('gameState', {}).get('achievementPoints', 0) == 0;
    }

    function usesServerSaveProtocol() {
      return resource.data.get('saveProtocolVersion', 0) >= 2;
    }

    function onlyAccountMetadataChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'profile',
        'activeDeviceId',
        'updatedAt'
      ]);
    }

    function validRanking(userId) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'nickname',
          'photoURL',
          'honorPoints',
          'achievementPoints',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'honorPoints',
          'achievementPoints'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.honorPoints is number
        && request.resource.data.achievementPoints is number
        && (!('nickname' in request.resource.data) || request.resource.data.nickname is string)
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL == null || request.resource.data.photoURL is string);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && initialUserDocument();
      // Accounts migrate gradually. Legacy clients may keep saving until the
      // first protocol-2 server save. After migration, only harmless profile
      // and session metadata can be changed directly; complete game snapshots
      // must pass through the revision-checked Cloud Function.
      allow update: if isOwner(userId)
        && (!usesServerSaveProtocol() || onlyAccountMetadataChanged());
      allow delete: if isOwner(userId);
    }

    // Backups are written by the server save transaction. Clients can recover
    // them but cannot replace recovery data directly.
    match /users/{userId}/gameStateBackups/{backupId} {
      allow read: if isOwner(userId) && backupId == 'latest';
      allow write: if false;
    }

    match /rankings/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && validRanking(userId);
      allow delete: if isOwner(userId);
    }

    match /rankingState/{userId} {
      allow read, write: if false;
    }

    match /rankingEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
