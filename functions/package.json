{
  "name": "koiworld-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test lib/progression.test.js",
    "test:integration": "node integration/account-state.emulator.mjs",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions,firestore:rules"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  },
  "overrides": {
    "brace-expansion": "^2.1.4",
    "minimatch": "^9.0.9",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
