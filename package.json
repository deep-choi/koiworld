{
  "name": "koiworld",
  "private": true,
  "version": "1.0.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode monetization-mock",
    "build": "vite build && node scripts/check-production-build.cjs",
    "typecheck": "tsc --noEmit",
    "test:save": "node --test tests/save.test.cjs",
    "test:achievements": "node --test tests/achievement.test.cjs",
    "test:rendering": "node --test tests/koi-renderer.test.cjs",
    "test:genetics": "node --test tests/motoguro.test.cjs tests/traits.test.cjs",
    "test:news": "node --test tests/news.test.cjs",
    "test:monetization": "node --test tests/monetization.test.cjs",
    "test": "node --test tests/*.test.cjs && npm --prefix functions test",
    "audit:release": "npm audit --omit=dev",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync",
    "cap:open": "cap open android",
    "cap:run": "cap run android"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/native-purchases": "^8.9.6",
    "@google/genai": "^1.29.0",
    "firebase": "^12.15.0",
    "lucide-react": "^0.552.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
